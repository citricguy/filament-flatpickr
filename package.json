{
    "name": "filament-flatpickr",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/filament-flatpickr.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/filament-flatpickr.css --minify",
        "build:scripts": "node bin/build.js",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.0.0",
        "autoprefixer": "^10.4.20",
        "esbuild": "^0.24.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.49",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.9",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "dayjs": "^1.11.13",
        "flatpickr": "^4.6.13"
    }
}
